{
    "java.project.sourcePaths": ["src", "test"],
    "java.project.outputPath": "bin",
    "java.project.referencedLibraries": [
        "lib/junit-jupiter-api_5.14.3.jar",
        "lib/junit-jupiter-engine_5.14.3.jar",
        "lib/junit-platform-commons_1.14.3.jar",
        "lib/junit-platform-engine_1.14.3.jar",
        "lib/junit-platform-launcher_1.14.3.jar",
        "lib/org.apiguardian.api_1.1.2.jar",
        "lib/org.opentest4j_1.3.0.jar",
        "lib/opencsv-5.9.jar",
        "lib/hamcrest-core-1.3.jar"
    ],
    "java.configuration.updateBuildConfiguration": "automatic",
    "java.test.config": [
        {
            "name": "TicketMiner JUnit",
            "workingDirectory": "${workspaceFolder}",
            "classPaths": [
                "${workspaceFolder}/bin",
                "${workspaceFolder}/lib/junit-jupiter-api_5.14.3.jar",
                "${workspaceFolder}/lib/junit-jupiter-engine_5.14.3.jar",
                "${workspaceFolder}/lib/junit-platform-commons_1.14.3.jar",
                "${workspaceFolder}/lib/junit-platform-engine_1.14.3.jar",
                "${workspaceFolder}/lib/junit-platform-launcher_1.14.3.jar",
                "${workspaceFolder}/lib/org.apiguardian.api_1.1.2.jar",
                "${workspaceFolder}/lib/org.opentest4j_1.3.0.jar",
                "${workspaceFolder}/lib/opencsv-5.9.jar",
                "${workspaceFolder}/lib/hamcrest-core-1.3.jar"
            ]
        }
    ],
    "java.test.defaultConfig": "TicketMiner JUnit",
    "java.checkstyle.configuration": "${workspaceFolder}/google_checks.xml",
    "java.checkstyle.version": "13.4.1",
    "java.jdt.ls.vmargs": "-XX:+UseParallelGC -XX:GCTimeRatio=4 -XX:AdaptiveSizePolicyWeight=90 -Dsun.zip.disableMemoryMapping=true -Xmx4G -Xms100m -Xlog:disable"
}
